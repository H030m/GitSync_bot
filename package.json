{
  "name": "discord-github-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot for bidirectional sync with GitHub Issues & Projects v2",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "register": "node dist/discord/registerCommands.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@napi-rs/canvas": "^1.0.8",
    "@octokit/app": "^15.1.0",
    "@octokit/core": "^6.1.0",
    "@octokit/request": "^9.2.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
