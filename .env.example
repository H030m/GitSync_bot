# ── Discord ──────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=           # 選填：開發時只註冊到特定 guild
# ── GitHub App ──────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=     # PEM 內容或 .pem 檔案路徑
GITHUB_INSTALLATION_ID=
# ── GitHub OAuth (App 的 Client ID/Secret) ──────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ── Firestore ───────────────────────────────────────
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=  # 服務帳號 JSON key 路徑
# ── Encryption ──────────────────────────────────────
ENCRYPTION_KEY=             # 32-byte hex（openssl rand -hex 32）
# ── Repo Watcher（監控 repo 何時公開）────────────────
WATCH_ENABLED=true
WATCH_REPO=hpcac/2026-APAC-HPC-AI
WATCH_INTERVAL_MINUTES=60
WATCH_CLONE_DIR=./repos          # pm2 部署用相對路徑；Docker 部署改成 /data/repos
WATCH_NOTIFY_ON_PRIVATE=true   # 每次掃到還是 private 就回報一則（設 false 可安靜）
# ── HTTP Server ─────────────────────────────────────
PORT=3000
BASE_URL=                   # e.g. https://bot.example.com
