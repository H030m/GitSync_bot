# ── Discord ──────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=           # 選填：開發時只註冊到特定 guild
# ── GitHub App ──────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=     # PEM 內容或 .pem 檔案路徑
GITHUB_INSTALLATION_ID=
# ── GitHub OAuth (App 的 Client ID/Secret) ──────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ── Firestore ───────────────────────────────────────
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=  # 服務帳號 JSON key 路徑
# ── Encryption ──────────────────────────────────────
ENCRYPTION_KEY=             # 32-byte hex（openssl rand -hex 32）
# ── Repo Watcher（監控 repo 何時公開）────────────────
WATCH_ENABLED=true
WATCH_REPO=hpcac/2026-APAC-HPC-AI
WATCH_INTERVAL_MINUTES=60
WATCH_CLONE_DIR=./repos          # pm2 部署用相對路徑；Docker 部署改成 /data/repos
WATCH_NOTIFY_ON_PRIVATE=true   # 每次掃到還是 private 就回報一則（設 false 可安靜）
# ── HTTP Server ─────────────────────────────────────
PORT=3000
BASE_URL=                   # e.g. https://bot.example.com

# --- /live-alert：YouTube 直播轉錄＋考試警報（詳見 README §7）---
# 擁有者的 Discord user ID；留空則 ask / ideas / ask-access 沒有人能用
LIVE_ALERT_OWNER_ID=
# 以下皆選填，括號內是預設值
# LIVE_ALERT_PYTHON=./stream2txt/.venv/bin/python
# LIVE_ALERT_WORKER=./stream2txt/worker.py
# LIVE_ALERT_ASK=./stream2txt/ask_once.py
# LIVE_ALERT_MODEL=small            # Whisper 模型：base / small / ...
# LIVE_ALERT_LANGUAGE=auto
# LIVE_ALERT_REFRESH_SECONDS=25     # 每幾秒重新取一次串流網址
# LIVE_ALERT_MAX_SESSIONS=1         # 同時追蹤幾個直播
# STREAM2TXT_LLM=0                  # 設 0 關閉 LLM 第二關，只留規則偵測
# STREAM2TXT_LLM_MODEL=haiku
